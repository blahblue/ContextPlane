# Copy this file to .env for local development.
# These are disposable local-development values only. Replace them as needed.
# Do not commit real credentials.

CONTEXTPLANE_DB_NAME=contextplane
CONTEXTPLANE_DB_USER=contextplane
CONTEXTPLANE_DB_PASSWORD=contextplane-local-only
CONTEXTPLANE_DATABASE_URL=postgresql+psycopg://contextplane:contextplane-local-only@localhost:5432/contextplane
