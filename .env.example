# Copy this file to .env for local development.
# These are disposable local-development values only. Replace them as needed.
# Do not commit real credentials.

CONTEXTPLANE_DB_NAME=contextplane
CONTEXTPLANE_DB_USER=contextplane
CONTEXTPLANE_DB_PASSWORD=contextplane-local-only
CONTEXTPLANE_DATABASE_URL=postgresql+psycopg://contextplane:contextplane-local-only@localhost:5432/contextplane
# Local Docker PostgreSQL is plaintext. Set true in production with sslmode=verify-full when possible.
CONTEXTPLANE_DATABASE_REQUIRE_TLS=false

# Optional reference Microsoft Entra authentication configuration.
# The pinned-key validator is intended for local/reference deployments.
# Never commit a real private key or production secret.
# CONTEXTPLANE_ENTRA_TENANT_ID=11111111-2222-3333-4444-555555555555
# CONTEXTPLANE_ENTRA_ISSUER=https://login.microsoftonline.com/11111111-2222-3333-4444-555555555555/v2.0
# CONTEXTPLANE_ENTRA_AUDIENCE=api://contextplane
# CONTEXTPLANE_ENTRA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# Public URL of the remote MCP endpoint. The Entra audience remains the API
# audience above; this URL is published through MCP protected-resource metadata.
CONTEXTPLANE_MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp

# REST perimeter defaults. Keep API docs disabled in production.
CONTEXTPLANE_EXPOSE_API_DOCS=false
CONTEXTPLANE_HTTP_RATE_LIMIT_PER_MINUTE=120
CONTEXTPLANE_HTTP_RATE_LIMIT_MAX_CLIENTS=10000
